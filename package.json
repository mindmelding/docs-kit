{
  "name": "docs-kit",
  "version": "0.1.0",
  "description": "Turn a folder of Markdown into a fast, static docs site: tabs, sidebar, table of contents, search, dark mode and llms.txt.",
  "type": "module",
  "license": "MIT",
  "bin": { "docs-kit": "bin/docs-kit.js" },
  "files": ["bin", "src"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node bin/docs-kit.js build help --out dist",
    "dev": "node bin/docs-kit.js dev help",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "markdown-it": "^15.0.2",
    "markdown-it-container": "^4.0.0",
    "shiki": "^4.4.3"
  }
}
